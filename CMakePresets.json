{
  "version": 2,
  "configurePresets": [
    {
      "name": "base-release",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OAS_BUILD_GUI": "ON",
        "OAS_BUILD_NODE": "ON",
        "OAS_BUILD_EXAMPLE_DRIVER": "ON",
        "OAS_BUILD_HARDWARE_PROBE": "ON",
        "OAS_BUILD_NATIVE_REFERENCE_DRIVERS": "ON",
        "OAS_ENABLE_NATIVE_GEMINI": "ON",
        "OAS_ENABLE_NATIVE_SKYWATCHER": "ON",
        "OAS_ENABLE_GPHOTO2": "OFF"
      }
    },
    {
      "name": "windows-core-release",
      "displayName": "Windows x64 core (MSVC + Ninja; no vendor camera SDKs)",
      "inherits": "base-release",
      "binaryDir": "${sourceDir}/build/windows-core",
      "cacheVariables": {
        "OAS_ENABLE_QHY": "OFF",
        "OAS_ENABLE_NATIVE_CANON": "OFF",
        "OAS_ENABLE_NATIVE_ZWO_ASI": "OFF",
        "OAS_ENABLE_NATIVE_ZWO_EAF": "OFF",
        "OAS_ENABLE_INDI": "OFF",
        "OAS_REQUIRE_MSVC": "ON"
      }
    },
    {
      "name": "windows-native-release",
      "displayName": "Windows x64 native observatory (MSVC + Ninja; vendor SDKs; no INDI)",
      "inherits": "base-release",
      "binaryDir": "${sourceDir}/build/windows-native",
      "cacheVariables": {
        "OAS_ENABLE_QHY": "ON",
        "OAS_ENABLE_NATIVE_CANON": "ON",
        "OAS_CANON_TRANSPORT": "EDSDK",
        "OAS_ENABLE_NATIVE_ZWO_ASI": "ON",
        "OAS_ENABLE_NATIVE_ZWO_EAF": "ON",
        "OAS_ENABLE_INDI": "OFF",
        "OAS_REQUIRE_MSVC": "ON"
      }
    },
    {
      "name": "windows-observatory-release",
      "displayName": "Windows x64 observatory (native + optional compatibility)",
      "inherits": "windows-native-release",
      "binaryDir": "${sourceDir}/build/windows-observatory",
      "cacheVariables": {
        "OAS_ENABLE_INDI": "ON"
      }
    },
    {
      "name": "linux-native-release",
      "displayName": "Linux native observatory (x86_64 or ARM64)",
      "inherits": "base-release",
      "binaryDir": "${sourceDir}/build/linux-native",
      "cacheVariables": {
        "OAS_ENABLE_QHY": "ON",
        "OAS_ENABLE_NATIVE_CANON": "ON",
        "OAS_CANON_TRANSPORT": "GPHOTO2",
        "OAS_ENABLE_NATIVE_ZWO_ASI": "ON",
        "OAS_ENABLE_NATIVE_ZWO_EAF": "ON",
        "OAS_ENABLE_INDI": "OFF",
        "CMAKE_INSTALL_PREFIX": "/usr/local"
      }
    },
    {
      "name": "linux-observatory-release",
      "displayName": "Linux observatory (native + INDI compatibility)",
      "inherits": "linux-native-release",
      "binaryDir": "${sourceDir}/build/linux-observatory",
      "cacheVariables": {
        "OAS_ENABLE_INDI": "ON"
      }
    },
    {
      "name": "linux-node-release",
      "displayName": "Linux headless observatory node",
      "inherits": "linux-observatory-release",
      "binaryDir": "${sourceDir}/build/linux-node",
      "cacheVariables": {
        "OAS_BUILD_GUI": "OFF"
      }
    },
    {
      "name": "rpi4-native-release",
      "displayName": "Raspberry Pi 4 / ARM64 native observatory",
      "inherits": "linux-native-release",
      "binaryDir": "${sourceDir}/build/rpi4-native"
    },
    {
      "name": "rpi4-observatory-release",
      "displayName": "Raspberry Pi 4 / ARM64 observatory (native + INDI compatibility)",
      "inherits": "linux-observatory-release",
      "binaryDir": "${sourceDir}/build/rpi4-observatory"
    },
    {
      "name": "node-sim-release",
      "displayName": "Headless simulator node",
      "inherits": "base-release",
      "binaryDir": "${sourceDir}/build/node-sim",
      "cacheVariables": {
        "OAS_BUILD_GUI": "OFF",
        "OAS_ENABLE_QHY": "OFF",
        "OAS_ENABLE_NATIVE_CANON": "OFF",
        "OAS_ENABLE_NATIVE_ZWO_ASI": "OFF",
        "OAS_ENABLE_NATIVE_ZWO_EAF": "OFF",
        "OAS_ENABLE_NATIVE_GEMINI": "OFF",
        "OAS_ENABLE_NATIVE_SKYWATCHER": "OFF",
        "OAS_ENABLE_INDI": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-core-release", "configurePreset": "windows-core-release" },
    { "name": "windows-native-release", "configurePreset": "windows-native-release" },
    { "name": "windows-observatory-release", "configurePreset": "windows-observatory-release" },
    { "name": "linux-native-release", "configurePreset": "linux-native-release" },
    { "name": "linux-observatory-release", "configurePreset": "linux-observatory-release" },
    { "name": "linux-node-release", "configurePreset": "linux-node-release" },
    { "name": "rpi4-native-release", "configurePreset": "rpi4-native-release" },
    { "name": "rpi4-observatory-release", "configurePreset": "rpi4-observatory-release" },
    { "name": "node-sim-release", "configurePreset": "node-sim-release" }
  ]
}
