{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default-release",
      "displayName": "Default Release (GUI + node)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OAS_BUILD_GUI": "ON",
        "OAS_BUILD_NODE": "ON",
        "OAS_BUILD_EXAMPLE_DRIVER": "ON"
      }
    },
    {
      "name": "windows-vs2022",
      "displayName": "Windows Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022",
      "cacheVariables": {
        "OAS_BUILD_GUI": "ON",
        "OAS_BUILD_NODE": "ON",
        "OAS_BUILD_EXAMPLE_DRIVER": "ON"
      }
    },
    {
      "name": "rpi4-observatory-release",
      "displayName": "Raspberry Pi 4 observatory (QHY + INDI)",
      "inherits": "default-release",
      "binaryDir": "${sourceDir}/build/rpi4-observatory",
      "cacheVariables": {
        "OAS_BUILD_GUI": "ON",
        "OAS_BUILD_NODE": "ON",
        "OAS_ENABLE_QHY": "ON",
        "OAS_ENABLE_INDI": "ON",
        "OAS_ENABLE_GPHOTO2": "OFF",
        "OAS_BUILD_HARDWARE_PROBE": "ON",
        "CMAKE_INSTALL_PREFIX": "/usr/local"
      }
    },
    {
      "name": "node-sim-release",
      "displayName": "Headless node only (simulated/basic backends)",
      "inherits": "default-release",
      "binaryDir": "${sourceDir}/build/node-sim",
      "cacheVariables": {
        "OAS_BUILD_GUI": "OFF",
        "OAS_BUILD_NODE": "ON",
        "OAS_ENABLE_QHY": "OFF",
        "OAS_ENABLE_INDI": "OFF",
        "OAS_ENABLE_GPHOTO2": "OFF",
        "OAS_BUILD_HARDWARE_PROBE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default-release",
      "configurePreset": "default-release"
    },
    {
      "name": "windows-vs2022",
      "configurePreset": "windows-vs2022",
      "configuration": "Release"
    },
    {
      "name": "rpi4-observatory-release",
      "configurePreset": "rpi4-observatory-release"
    },
    {
      "name": "node-sim-release",
      "configurePreset": "node-sim-release"
    }
  ]
}
