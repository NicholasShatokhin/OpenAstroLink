[Unit]
Description=INDI server for OpenAstroLink observatory hardware
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/openastrolink/indi-drivers.conf
ExecStart=/bin/sh -c '/usr/bin/indiserver -v ${INDI_DRIVERS}'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
