# Optional OpenAstroLink node environment overrides.
# Uncomment only when autodetection/default locations are insufficient.

# OAL_ASTAP_EXECUTABLE=/usr/bin/astap_cli
# OAL_ASTAP_DATABASE=/opt/astap
# OAL_ASTAP_TIMEOUT_MS=180000

# Reduce optional OpenCV backend discovery noise in service logs.
OPENCV_LOG_LEVEL=WARNING
