{
  "schema": "org.openastrolink.driver-manifest/v2",
  "driverId": "oal.zwo.eaf",
  "name": "OpenAstroLink native ZWO EAF focuser driver",
  "version": "0.2.10.19",
  "abiVersion": 2,
  "library": "oal_driver_zwo_eaf",
  "deviceClasses": [
    "focuser"
  ],
  "isolation": "in-process",
  "permissions": [
    {
      "kind": "usb",
      "vendor": "ZWO"
    }
  ],
  "threadModel": "per-device-serial",
  "trust": "bundled",
  "transport": {
    "kind": "vendor-sdk",
    "sdk": "ZWO EAF SDK"
  },
  "config": {}
}
