{
  "schema": "org.openastrolink.driver-manifest/v2",
  "driverId": "oal.canon",
  "name": "OpenAstroLink native Canon EOS driver",
  "version": "0.2.10.13",
  "abiVersion": 2,
  "library": "oal_driver_canon",
  "deviceClasses": [
    "camera"
  ],
  "isolation": "in-process",
  "permissions": [
    {
      "kind": "usb",
      "vendor": "Canon"
    },
    {
      "kind": "filesystem",
      "path": "user-capture-directory",
      "access": "write"
    }
  ],
  "threadModel": "per-device-serial",
  "trust": "bundled",
  "config": {
    "spoolDir": "",
    "deleteFromCamera": true
  },
  "transportSelection": "build-time: EDSDK on Windows AUTO, libgphoto2 on Linux AUTO"
}
