{
  "schema": "org.openastrolink.driver-manifest/v2",
  "driverId": "oal.canon",
  "name": "OpenAstroLink native Canon EOS driver",
  "version": "0.2.9",
  "abiVersion": 2,
  "library": "oal_driver_canon",
  "deviceClasses": ["camera"],
  "isolation": "in-process",
  "permissions": [
    {"kind": "usb", "vendor": "Canon"},
    {"kind": "filesystem", "path": "/var/lib/openastrolink/captures/canon", "access": "write"}
  ],
  "threadModel": "per-device-serial",
  "trust": "bundled",
  "config": {
    "spoolDir": "/var/lib/openastrolink/captures/canon",
    "deleteFromCamera": true
  }
}
