{
  "schema": "org.openastrolink.driver-manifest/v2",
  "abiVersion": 2,
  "driverId": "oal.eqdrive",
  "name": "OpenAstroLink native EQDrive (EQMOD Motor Controller + ASTEP)",
  "version": "0.2.10.19",
  "library": "oal_driver_eqdrive",
  "deviceClasses": [
    "mount"
  ],
  "threadModel": "per-device-serial",
  "isolation": "in-process",
  "permissions": [
    "serial"
  ],
  "config": {
    "ports": [],
    "baudRates": [
      115200,
      9600,
      19200,
      921600
    ],
    "probeTimeoutMs": 700,
    "commandTimeoutMs": 2500,
    "openSettleMs": 250,
    "raSkyPerAxis": -1.0,
    "decSkyPerAxis": 1.0,
    "maxNativeGotoDeg": 15.0,
    "guideRateDegPerHour": 7.520534
  }
}
